# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:4200
SWAGGER_ENABLED=true
LOG_LEVEL=debug
TZ=Asia/Bangkok

# ── SQL Server: CMS_DB (ฐานหลัก) ──────────────────────
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=change-me
DB_NAME=CMS_DB
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true
DB_POOL_MAX=20
DB_REQUEST_TIMEOUT_MS=30000
DB_LOGGING=false

# ── SQL Server: BUI_RG (ฐานโครงการ RGP) — ว่าง = ใช้ server/ผู้ใช้เดียวกับฐานหลัก ──
PROJECT_DB_NAME=BUI_RG
# PROJECT_DB_HOST=
# PROJECT_DB_USER=
# PROJECT_DB_PASSWORD=

# ── Auth ─────────────────────────────────────────────
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=1h
AD_AUTH_BASE_URL=http://auth.company.local
AD_AUTH_LOGIN_PATH=/api/auth/login
AD_AUTH_VALIDATE_PATH=/api/auth/validate
AUTH_AUTO_PROVISION=true

# ── CRUD log ─────────────────────────────────────────
# off | write (ค่าเริ่มต้น: เก็บเฉพาะ create/update/delete/execute) | all (รวม read)
CRUD_LOG_LEVEL=write
CRUD_LOG_CONSOLE=true
CRUD_LOG_AUDIT_DB=false

# ── ไฟล์ DMS ─────────────────────────────────────────
STORAGE_ROOT=./storage-data
STORAGE_MAX_UPLOAD_MB=100
